# Meeting Assistant 后端配置

# 服务端口(自研后端)
PORT=4001

# dsh 后端地址(dsh web 启动后)
DSH_BASE_URL=http://127.0.0.1:3080
DSH_PRESET=ai-meeting-assistant

# FunASR 服务地址(用户自己的服务器)
FUNASR_URL=ws://your-funasr-server.com:10095

# 预设扫描的项目根目录(JSON 数组)
PROJECT_SCAN_DIRS=["D:\\projects","D:\\workspace"]

# LLM 配置(决策层:意图提取/去重/关系判断,Anthropic Messages 兼容)
MINIMAX_CN_API_KEY=eyJhbGc...
LLM_MODEL=MiniMax-M3
# 换 provider 示例:
#   Anthropic 官方:  LLM_BASE_URL=https://api.anthropic.com
#   其他兼容网关:    LLM_BASE_URL=https://your-gateway.com/anthropic
LLM_BASE_URL=https://api.minimaxi.com/anthropic

# dsh 执行层模型(headless profile)
# server 启动时自动写入 ~/.dsh/profiles/headless/cordis.patch.yml
# provider 必须是 ~/.dsh/settings.yaml llm-pi-ai.providers 里已定义的
DSH_EXECUTOR_PROVIDER=minimax-cn
DSH_EXECUTOR_MODEL=MiniMax-M3
# provider 的 API key(settings.yaml 里 provider 声明的 apiKeyEnv 名称)
# 留空则回退用上面的 MINIMAX_CN_API_KEY
DSH_EXECUTOR_API_KEY=
DSH_EXECUTOR_API_KEY_ENV=MINIMAX_CN_API_KEY
# 切换示例(用你本地 tokenhub):
# DSH_EXECUTOR_PROVIDER=tokenhub
# DSH_EXECUTOR_MODEL=coding-algorithm-high
# DSH_EXECUTOR_API_KEY_ENV=TOKENHUB_API_KEY

# 日志
LOG_LEVEL=info